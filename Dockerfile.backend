FROM python:3.11 AS runtime

ARG USE_MIRROR=False
ARG MIRROR_PIP_INDEX_URL=
ARG MIRROR_PIP_EXTRA_INDEX_URL=
ARG MIRROR_PIP_TRUSTED_HOST=

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/certs

COPY backend/requirements.runtime.txt /tmp/requirements.runtime.txt
COPY certs/ca/ /opt/certs/

# Install backend runtime dependencies in a separate cacheable layer.
# This avoids reinstalling dependencies on every source code change.
RUN set -eux; \
    if [ "${USE_MIRROR}" = "True" ] || [ "${USE_MIRROR}" = "true" ]; then \
      export PIP_INDEX_URL="${MIRROR_PIP_INDEX_URL}"; \
      [ -z "${MIRROR_PIP_EXTRA_INDEX_URL}" ] || export PIP_EXTRA_INDEX_URL="${MIRROR_PIP_EXTRA_INDEX_URL}"; \
      [ -z "${MIRROR_PIP_TRUSTED_HOST}" ] || export PIP_TRUSTED_HOST="${MIRROR_PIP_TRUSTED_HOST}"; \
    fi; \
    for attempt in 1 2 3; do \
      python -m pip install --no-cache-dir --upgrade pip && break; \
      if [ "${attempt}" -eq 3 ]; then exit 1; fi; \
      echo "pip upgrade failed, retrying (${attempt}/3)..." >&2; \
      sleep 5; \
    done; \
    for attempt in 1 2 3; do \
      pip install --no-cache-dir --retries 10 --timeout 120 -r /tmp/requirements.runtime.txt && break; \
      if [ "${attempt}" -eq 3 ]; then exit 1; fi; \
      echo "pip install failed, retrying (${attempt}/3)..." >&2; \
      sleep 5; \
    done; \
    rm -f /tmp/requirements.runtime.txt || true

ENV SSL_CERT_FILE=/opt/certs/inno_pki_chain.pem
ENV REQUESTS_CA_BUNDLE=/opt/certs/inno_pki_chain.pem
ENV CURL_CA_BUNDLE=/opt/certs/inno_pki_chain.pem

RUN adduser --disabled-password --gecos "" --no-create-home appuser
RUN mkdir -p /tmp/llm-data-analyst && chown -R appuser:appuser /tmp/llm-data-analyst

COPY backend ./backend
COPY skills ./skills
COPY tools ./tools

RUN chown -R appuser:appuser /app /opt/certs
USER appuser

EXPOSE 8000

CMD ["uvicorn", "backend.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
