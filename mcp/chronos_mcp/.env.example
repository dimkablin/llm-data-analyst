# MCP transport
CHRONOS_MCP_HOST=127.0.0.1
CHRONOS_MCP_PORT=8810
CHRONOS_MCP_TRANSPORT=streamable-http
CHRONOS_MCP_LOG_LEVEL=INFO
CHRONOS_MCP_API_KEY=
CHRONOS_MCP_API_KEY_FILE=
CHRONOS_MCP_PUBLIC_URL=http://127.0.0.1:8810/mcp

# Model. Pin CHRONOS_MODEL_REVISION in production.
CHRONOS_MODEL_ALIAS=chronos2-default
CHRONOS_MODEL_ID=amazon/chronos-2
CHRONOS_MODEL_REVISION=main
CHRONOS_MODEL_FAMILY=chronos2
CHRONOS_DEVICE=auto
CHRONOS_DTYPE=auto
CHRONOS_MAX_HORIZON=256
CHRONOS_MAX_CONTEXT_POINTS=8192

# Optional read-only Data Gateway. Keep the token in a secret store.
CHRONOS_DATA_GATEWAY_URL=
CHRONOS_DATA_GATEWAY_TOKEN=
CHRONOS_QUERY_TIMEOUT_SEC=30
