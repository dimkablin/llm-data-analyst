# Generate two different values, for example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CHRONOS_MCP_API_KEY=replace-with-a-unique-chronos-key
SEARXNG_MCP_API_KEY=replace-with-a-different-searxng-key

# Host exposure. Use 0.0.0.0 only when remote access is required.
MCP_BIND_ADDRESS=127.0.0.1
CHRONOS_MCP_HOST_PORT=8810
SEARXNG_MCP_HOST_PORT=8811
SEARCH_SERVICE_BIND_ADDRESS=127.0.0.1
SEARCH_SERVICE_HOST_PORT=8610

# Chronos model
CHRONOS_MODEL_ALIAS=chronos2-default
CHRONOS_MODEL_ID=amazon/chronos-2
CHRONOS_MODEL_REVISION=main
CHRONOS_DEVICE=auto
CHRONOS_DTYPE=auto
CHRONOS_PYTORCH_IMAGE=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

# Optional read-only data gateway
CHRONOS_DATA_GATEWAY_URL=
CHRONOS_DATA_GATEWAY_TOKEN=

# Search
SEARXNG_MIN_SCORE=0.0
SEARCH_TIMEOUT_SEC=20.0
FETCH_TIMEOUT_SEC=15.0
SEARCH_FETCH_MAX_CHARS=10000
