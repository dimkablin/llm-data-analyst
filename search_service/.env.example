# SearXNG connection (search_service FastAPI)
SEARXNG_API_URL=http://searxng:8080

# searxng-mcp service (docker-compose): bridge v0.11+ requires SEARXNG_INSTANCE_URL
# (set in docker-compose.yml; override if you run MCP outside compose)
# SEARXNG_INSTANCE_URL=http://searxng:8080

# Score filter (0.0 = no filter)
SEARXNG_MIN_SCORE=0.0

# Timeouts
SEARCH_TIMEOUT_SEC=20.0
FETCH_TIMEOUT_SEC=15.0

# Max chars fetched per page (0 = unlimited)
SEARCH_FETCH_MAX_CHARS=10000

# Port exposed by docker-compose
SEARCH_SERVICE_PORT=8610
