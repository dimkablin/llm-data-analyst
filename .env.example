# Mirrors / registries (for installation flows, build-args only)
USE_MIRROR=False
APT_MIRROR=http://mirror.inno.tech/repository/apt-proxy22
APT_CODENAME=jammy
APT_FALLBACK_CODENAME=bookworm
PIP_INDEX_URL=https://nexus.inno.tech/repository/common-proxy-pypi-pypi_org/simple
PIP_EXTRA_INDEX_URL=
PIP_TRUSTED_HOST=nexus.inno.tech
NPM_REGISTRY=https://nexus.inno.tech/repository/common-proxy-npm-npmjs

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=vllm
LLM_MODEL_NAME=Qwen3.5-35B-A3B-FP8
LLM_API_KEY=EMPTY
LLM_MODEL_API_URL=http://host.docker.internal:8123/v1
LLM_CHAT_TEMPLATE_KWARGS_ENABLED=true
LLM_TEMPERATURE_CHAT=0.7
LLM_TEMPERATURE_TOOL=0.5
LLM_MAX_TOKENS_DEFAULT=4096
LLM_MAX_TOKENS_REASONING=4096
LLM_TOP_P=0.95
LLM_TOP_K=20
LLM_PRESENCE_PENALTY=1.5
LLM_ENABLE_THINKING=true
# Whether to include raw <think>...</think> blocks in responses (shown to user)
LLM_SHOW_THINK=true
# Context window size — relevant for Ollama; ignored by vLLM
LLM_NUM_CTX=32768
# Compress chat history when prompt context reaches this fraction of LLM_NUM_CTX
MAX_CONTEXT_PER=0.8
LLM_STREAMING=true
LLM_WARMUP_ENABLED=true
LLM_WARMUP_TIMEOUT_SEC=12

# ── Tooling / Agent ───────────────────────────────────────────────────────────
TOOL_EXEC_TIMEOUT_SEC=25
TOOL_CACHE_SIZE=48
BACKEND_QUERY_TIMEOUT_SEC=180
AGENT_MAX_STEPS=32
AGENT_STEP_TIMEOUT_SEC=45
AGENT_HISTORY_MAX_MESSAGES=8
AGENT_HISTORY_SUMMARY_CHARS=700
AGENT_INNER_RECURSION_LIMIT=32
AGENT_PROMPT_MAX_COLUMNS=16
AGENT_PROMPT_HEAD_ROWS=3
AGENT_CACHE_ENABLED=true
AGENT_CACHE_SIZE=128
AGENT_CACHE_TTL_SEC=900
# Depth profile: light | medium | deep  (controls inner_recursion_limit ceiling)
AGENT_ANALYSIS_DEPTH=light
# Path to the skills directory (relative to working dir or absolute)
AGENT_SKILLS_DIR=./skills

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_SESSION_TTL_DAYS=7
BACKEND_MAX_DATASET_MB=100
BACKEND_STORAGE_DIR_DOCKER=/tmp/llm-data-analyst
BACKEND_CORS_ALLOW_ORIGINS=*
AUTH_TOKEN_TTL_DAYS=30
AUTH_DEFAULT_ADMIN_USERNAME=admin
AUTH_DEFAULT_ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# CSV session runtime (temp files for in-memory dataset operations)
CSV_SESSION_TTL_SEC=7200
CSV_SESSION_BASE_DIR_DOCKER=/tmp/llm-data-analyst/csv_sessions

# ── Frontend / reverse-proxy targets ─────────────────────────────────────────
# Used by nginx / docker-compose — not read by Python backend directly
BACKEND_URL=http://backend:8000
PHOENIX_URL=http://phoenix:6006
# Optional Vite overrides for local dev (read by vite.config.ts)
# APP_BASE_PATH=/
# VITE_API_BASE=http://localhost:9605
# VITE_PHOENIX_URL=http://localhost:9607
# Optional browser-facing Phoenix URL/path for links and iframe.
# Defaults to APP_BASE_PATH + /phoenix/.
# VITE_PHOENIX_PUBLIC_URL=http://localhost:9607
# VITE_PHOENIX_BASE_PATH=/phoenix

# ── Ports ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=9605
FRONTEND_PORT=9603
PHOENIX_UI_PORT=9607
PHOENIX_GRPC_PORT=9608
IMAGE_TAG=latest

# ── Postgres example datasets (docker-compose service: postgres_examples) ─────
POSTGRES_EXAMPLES_PORT=5433
POSTGRES_EXAMPLES_USER=analyst
POSTGRES_EXAMPLES_PASSWORD=analyst
POSTGRES_EXAMPLES_DB=examples
# JDBC-style from host: postgresql://analyst:analyst@localhost:5433/examples
# Tables: examples.titanic, examples.video_game_sales, examples.bank_churn_clients
# Re-seed: docker compose down; docker volume rm <project>_postgres_examples_data; docker compose up -d postgres_examples

# -- Semantic layer -----------------------------------------------------------
SEMANTIC_METADATA_USER=semantic
SEMANTIC_METADATA_PASSWORD=semantic
SEMANTIC_METADATA_DB=semantic_metadata
SEMANTIC_LAYER_ENABLED=true
SEMANTIC_PROFILE_MAX_TABLES=100
SEMANTIC_PROFILE_MAX_COLUMNS_PER_TABLE=200
SEMANTIC_PROFILE_SAMPLE_ROWS=1000
SEMANTIC_PROFILE_TOP_VALUES=20
SEMANTIC_PROFILE_TIMEOUT_SEC=60
# Dedicated PostgreSQL database for profiling and semantic metadata.
SEMANTIC_METADATA_DATABASE_URL=postgresql://semantic:semantic@semantic_metadata:5432/semantic_metadata
SEMANTIC_METADATA_SCHEMA=public
SEMANTIC_VECTOR_ENABLED=true
SEMANTIC_QDRANT_URL=http://qdrant:6333
SEMANTIC_QDRANT_COLLECTION=semantic_catalog_chunks_bge_m3_1024_v1
# bge-m3 is exposed by the vLLM OpenAI-compatible embeddings endpoint.
SEMANTIC_EMBEDDING_PROVIDER=openai
SEMANTIC_EMBEDDING_BASE_URL=http://host.docker.internal:8004/v1
SEMANTIC_EMBEDDING_API_KEY=EMPTY
SEMANTIC_EMBEDDING_MODEL=bge-m3
SEMANTIC_EMBEDDING_DIM=1024
SEMANTIC_GENERATION_BATCH_TABLES=2
# Optional external Docker network containing the semantic metadata PostgreSQL service.
SEMANTIC_DOCKER_NETWORK=

# ── Utility ───────────────────────────────────────────────────────────────────
# OpenProject sync source.
# Button "OpenProject" loads projects, work_packages, time_entries and personnel
# from OpenProject API into the PostgreSQL schema below, then binds it as a DB source.
OPENPROJECT_BASE_URL=http://host.docker.internal:8080
OPENPROJECT_HOST_HEADER=localhost:8080
OPENPROJECT_API_KEY=your_openproject_api_token
# Optional project identifier/name; leave blank to sync all visible projects.
OPENPROJECT_PROJECT=
OPENPROJECT_DAYS=90
# 0 means no per-table limit.
OPENPROJECT_MAX_ITEMS=0
OPENPROJECT_PG_HOST=postgres_examples
OPENPROJECT_PG_PORT=5432
OPENPROJECT_PG_DATABASE=examples
OPENPROJECT_PG_USERNAME=analyst
OPENPROJECT_PG_PASSWORD=analyst
OPENPROJECT_PG_SCHEMA=openproject
OPENPROJECT_PG_SSLMODE=prefer

# Redis cache (docker-compose service: redis)
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

COMPOSE_PROJECT_NAME=llm-data-analyst

# ── TLS / CA bundle ───────────────────────────────────────────────────────────
# If the path does not exist the variable is silently unset at startup
SSL_CERT_FILE=/opt/certs/ca.crt
REQUESTS_CA_BUNDLE=/opt/certs/ca.crt
CURL_CA_BUNDLE=/opt/certs/ca.crt
# SSL_CERT_DIR=/opt/certs

# ── Phoenix tracing ───────────────────────────────────────────────────────────
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=llm-data-analyst
PHOENIX_AUTO_INSTRUMENT=true
PHOENIX_HOST=localhost
PHOENIX_HOST_ROOT_PATH=/phoenix
# Leave blank to auto-build from PHOENIX_HOST + port 6006
PHOENIX_COLLECTOR_ENDPOINT=

# ── RAG integration ───────────────────────────────────────────────────────────
# Enabled automatically when RAG_URL is set (and RAG_ENABLED is not false)
RAG_ENABLED=false
RAG_URL=
RAG_QUERY_ENDPOINT=/query
RAG_TIMEOUT_SEC=45
RAG_VERIFY_SSL=false
RAG_QUERY_MODE=hybrid
RAG_TOP_K=5

# ── Forecast integration ──────────────────────────────────────────────────────
FORECAST_ENABLED=false
FORECAST_BACKEND_URL=
FORECAST_PREDICT_ENDPOINT=/v1/predict_ts_chronos
FORECAST_TIMEOUT_SEC=60
FORECAST_HORIZON_DEFAULT=3
FORECAST_SOURCE_LABEL=Forecast

# ── Anomaly / Plan-fact integration ───────────────────────────────────────────
ANOMALY_PLANFACT_ENABLED=false
ANOMALY_PLANFACT_BACKEND_URL=
ANOMALY_PLANFACT_ANALYZE_ENDPOINT=/v1/anomaly_detect_planfact
ANOMALY_PLANFACT_TIMEOUT_SEC=60
ANOMALY_PLANFACT_SOURCE_LABEL=Anomaly / Plan-fact

# ── Predict service (shared by Forecast & Anomaly) ────────────────────────────
# Public URL of this backend, used to build callback links inside predict UI
BACKEND_PUBLIC_API_URL=
# Base URL of the external predict/anomaly backend
PREDICT_BACKEND_URL=
PREDICT_THEME=dark

# ── DB connection config ──────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_CONNECTIONS_ENCRYPTION_KEY_CURRENT=PASTE_GENERATED_KEY_HERE
# Legacy key name — kept for backward compatibility during key rotation
DB_CONNECTIONS_ENCRYPTION_KEY=
# Comma-separated old keys for decryption during key rotation
DB_CONNECTIONS_ENCRYPTION_KEYS_OLD=
DB_CONNECTIONS_ALLOW_PRIVATE_HOSTS=true
DB_CONNECTIONS_TEST_TIMEOUT_SEC=8
