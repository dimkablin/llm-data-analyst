# Mirrors / registries (for installation flows)
USE_MIRROR=False
APT_MIRROR=http://mirror.inno.tech/repository/apt-proxy22
APT_CODENAME=jammy
APT_FALLBACK_CODENAME=bookworm
PIP_INDEX_URL=https://nexus.inno.tech/repository/common-proxy-pypi-pypi_org/simple
PIP_EXTRA_INDEX_URL=
PIP_TRUSTED_HOST=nexus.inno.tech
NPM_REGISTRY=https://nexus.inno.tech/repository/common-proxy-npm-npmjs

# LLM
LLM_PROVIDER=vllm
LLM_MODEL_NAME=Qwen3.5-35B-A3B-FP8
LLM_API_KEY=EMPTY
LLM_MODEL_API_URL=http://host.docker.internal:8123/v1
LLM_CHAT_TEMPLATE_KWARGS_ENABLED=true
LLM_TEMPERATURE_CHAT=0.7
LLM_TEMPERATURE_TOOL=0.5
LLM_MAX_TOKENS_DEFAULT=2048
LLM_MAX_TOKENS_REASONING=4096
LLM_TOP_P=0.95
LLM_TOP_K=20
LLM_PRESENCE_PENALTY=1.5
LLM_ENABLE_THINKING=true
LLM_STREAMING=true
LLM_STREAMING_FORCE=true
LLM_WARMUP_ENABLED=true
LLM_WARMUP_TIMEOUT_SEC=12

# Tooling / agent
TOOL_EXEC_TIMEOUT_SEC=25
TOOL_CACHE_SIZE=48
BACKEND_QUERY_TIMEOUT_SEC=180
AGENT_MAX_STEPS=10
AGENT_STEP_TIMEOUT_SEC=45
AGENT_HISTORY_MAX_MESSAGES=8
AGENT_HISTORY_SUMMARY_CHARS=700
AGENT_INNER_RECURSION_LIMIT=6
AGENT_PROMPT_MAX_COLUMNS=16
AGENT_PROMPT_HEAD_ROWS=3
AGENT_CACHE_ENABLED=true
AGENT_CACHE_SIZE=128
AGENT_CACHE_TTL_SEC=900
AGENT_EVALUATE_ENABLED=true
AGENT_EVALUATE_MAX_TOKENS=300
AGENT_ANALYSIS_DEPTH=light

# Backend
BACKEND_SESSION_TTL_DAYS=7
BACKEND_MAX_DATASET_MB=100
BACKEND_STORAGE_DIR=./backend_storage
BACKEND_STORAGE_DIR_DOCKER=/app/backend_storage
BACKEND_CORS_ALLOW_ORIGINS=*
AUTH_DB_PATH=./backend_storage/app.db
AUTH_DB_PATH_DOCKER=/app/backend_storage/app.db
AUTH_TOKEN_TTL_DAYS=30
AUTH_DEFAULT_ADMIN_USERNAME=admin
AUTH_DEFAULT_ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# Frontend reverse-proxy targets (use external URLs in sandbox)
BACKEND_URL=http://backend:8000
PHOENIX_URL=http://phoenix:6006

# Phoenix tracing
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=llm-data-analyst
PHOENIX_AUTO_INSTRUMENT=true
PHOENIX_HOST=localhost
PHOENIX_WORKING_DIR=/mnt/data
PHOENIX_HOST_ROOT_PATH=/phoenix

# Ports
BACKEND_PORT=8605
FRONTEND_PORT=8606
PHOENIX_UI_PORT=8607
PHOENIX_GRPC_PORT=8608

# Utility scripts
COMPOSE_PROJECT_NAME=llm-data-analyst

SSL_CERT_FILE=/opt/certs/ca.crt
REQUESTS_CA_BUNDLE=/opt/certs/ca.crt
CURL_CA_BUNDLE=/opt/certs/ca.crt

# ── Search bridge (search_service container) ──────────────────────────────────
# Enabled automatically when SEARCH_BACKEND_URL is set.
SEARCH_ENABLED=true
SEARCH_BACKEND_URL=http://search_service:8000
SEARCH_ENDPOINT=/api/v1/search/
SEARCH_FETCH_ENDPOINT=/api/v1/fetch/
SEARCH_TIMEOUT_SEC=20
SEARCH_MAX_RESULTS_DEFAULT=5
SEARCH_FETCH_TOP_N_DEFAULT=3
SEARCH_SOURCE_LABEL=Search

# search_service / SearXNG settings (passed to search_service container)
SEARCH_SERVICE_PORT=8610
SEARXNG_MIN_SCORE=0.0
SEARCH_FETCH_MAX_CHARS=10000

# External forecast integration
FORECAST_ENABLED=false
FORECAST_BACKEND_URL=
FORECAST_PREDICT_ENDPOINT=/v1/predict_ts_chronos
FORECAST_TIMEOUT_SEC=60
FORECAST_HORIZON_DEFAULT=3
FORECAST_SOURCE_LABEL=Forecast

ANOMALY_PLANFACT_ENABLED=false
ANOMALY_PLANFACT_BACKEND_URL=
ANOMALY_PLANFACT_ANALYZE_ENDPOINT=/v1/anomaly_detect_planfact
ANOMALY_PLANFACT_TIMEOUT_SEC=60
ANOMALY_PLANFACT_SOURCE_LABEL=Anomaly / Plan-fact

#  DB connection config
DB_CONNECTIONS_ENCRYPTION_KEY_CURRENT=PASTE_GENERATED_KEY_HERE
DB_CONNECTIONS_ALLOW_PRIVATE_HOSTS=true
